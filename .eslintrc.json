{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": ["eslint:recommended"],
  "rules": {
    "no-unused-vars": ["warn", {
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_",
      "caughtErrorsIgnorePattern": "^_"
    }],
    "no-empty": ["warn", { "allowEmptyCatch": true }],
    "no-constant-condition": ["error", { "checkLoops": false }],
    "no-prototype-builtins": "off",
    "no-control-regex": "off",
    "no-useless-escape": "warn"
  },
  "overrides": [
    {
      "files": ["tests/**/*.js", "**/*.test.js"],
      "env": {
        "jest": true,
        "node": true
      },
      "rules": {
        "no-unused-vars": "off"
      }
    },
    {
      "files": ["web/**/*.js", "web/**/*.vue"],
      "env": {
        "browser": true,
        "node": true
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/",
    "coverage/",
    "web/dist/",
    "web/node_modules/",
    "templates/",
    "ai-docs/"
  ]
}
