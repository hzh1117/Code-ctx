# Code-ctx local environment example
# Copy this file to .env and fill in real credentials locally.
# Never commit .env or real API keys.

# OpenAI-compatible providers: OpenAI, DeepSeek, Kimi, MiniMax, Zhipu, etc.
# 默认 model=gpt-5.5（gpt-4 将于 2026-10-23 退役，参见 OpenAI 官方 deprecations 页）。
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.5

# Anthropic-compatible providers: Anthropic Claude or compatible services.
# 默认 model=claude-sonnet-4-6（claude-3-5-sonnet-20241022 已于 2025-10-28 退役）。
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Some Anthropic-compatible services use auth-token naming.
# Keep this empty unless your provider explicitly requires it.
# ANTHROPIC_AUTH_TOKEN=

# AI request timeout in milliseconds.
# AI_TIMEOUT=180000

# Optional local Dashboard bearer token.
# When set, call Dashboard APIs with: Authorization: Bearer <token>
# DASHBOARD_TOKEN=

# Debug flags. Do not enable in shared logs because responses may contain private code.
# AI_DEBUG=false
# AI_DEBUG_RESPONSE=false

# Optional scan limits.
# MAX_FILES_PER_PROJECT=200
# MAX_PROJECT_TOKENS=500000

# ===================================================================
# 插件信任（可选） / Plugin trust (optional)
# ===================================================================
# 加载 code-ctx.config.json 中 plugins[] 列出的扩展时，loader 会强制要求
# 显式信任。下面两个变量用于跳过/扩展信任来源（参见 src/plugins/loader.js）。
#
# 开发/CI 环境可直接放行所有插件（生产环境不建议）：
# CODE_CTX_PLUGINS_ALLOW_ALL=1
#
# 仅放行指定插件（逗号分隔的 npm 包名或本地路径）：
# CODE_CTX_PLUGINS_ALLOW=@scope/plugin1,./my-plugin.js
#
# 首次运行遇到不在白名单的插件时会交互式提示确认，
# 用户确认后自动写入 ~/.code-ctx/allowed-plugins.json（持久化信任）。
