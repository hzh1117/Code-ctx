{
  "name": "code-ctx",
  "version": "1.1.0",
  "description": "AI 开发上下文工具，生成可复用的代码库上下文和 AI prompt",
  "main": "src/index.js",
  "bin": {
    "code-ctx": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "web/dist",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "SUPPORT.md",
    "TYPE_CHECKING.md",
    "examples/plugin-basic",
    ".env.example"
  ],
  "scripts": {
    "test": "jest",
    "coverage": "jest --coverage --runInBand",
    "format": "prettier --write .eslintrc.json .prettierrc.json package.json tsconfig.check.json TYPE_CHECKING.md \"src/**/*.js\" \"bin/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"web/src/**/*.{js,vue}\"",
    "format:check": "prettier --check .eslintrc.json .prettierrc.json package.json tsconfig.check.json TYPE_CHECKING.md \"src/**/*.js\" \"bin/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" \"web/src/**/*.{js,vue}\"",
    "lint": "eslint src/ bin/ web/src/ --ext .js,.vue",
    "typecheck": "tsc -p tsconfig.check.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test -- --runInBand && npm run coverage && npm run build:web && npm run pack:smoke",
    "build:web": "cd web && npm run build",
    "pack:smoke": "node scripts/package-smoke.js",
    "dashboard": "node bin/cli.js dashboard",
    "dashboard:dev": "node bin/cli.js dashboard --dev",
    "api": "node -e \"const { startServer } = require('./src/web/server'); startServer(process.cwd(), 3456);\""
  },
  "keywords": [
    "cli",
    "ai",
    "context",
    "developer-tools",
    "prompt",
    "codebase",
    "claude",
    "chatgpt",
    "cursor"
  ],
  "author": "hzh1117",
  "license": "MIT",
  "homepage": "https://github.com/hzh1117/Code-ctx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzh1117/Code-ctx.git"
  },
  "bugs": {
    "url": "https://github.com/hzh1117/Code-ctx/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "chardet": "^1.6.0",
    "clipboardy": "3.0.0",
    "commander": "^14.0.3",
    "express": "~5.2.1",
    "glob": "^10.5.0",
    "iconv-lite": "^0.7.2",
    "ignore": "^5.3.2",
    "json5": "^2.2.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "concurrently": "^9.2.1",
    "eslint": "^8.0.0",
    "eslint-plugin-vue": "^9.33.0",
    "jest": "^29.0.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "shell-quote": "1.8.4"
  },
  "jest": {
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/web/dist/",
      "/tests/fixtures/",
      "/tests/helpers/"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 85,
        "branches": 72,
        "functions": 88,
        "lines": 86
      },
      "./src/ai/privacy-gateway.js": {
        "statements": 90,
        "branches": 80,
        "functions": 100,
        "lines": 90
      },
      "./src/init/progress-reporter.js": {
        "statements": 90,
        "branches": 80,
        "functions": 100,
        "lines": 90
      },
      "./src/utils/sensitive-filter.js": {
        "statements": 90,
        "branches": 80,
        "functions": 100,
        "lines": 90
      }
    }
  }
}
