{
  "name": "code-ctx",
  "version": "1.0.0",
  "description": "AI 开发上下文工具，生成可复用的代码库上下文和 AI prompt",
  "main": "src/index.js",
  "bin": {
    "code-ctx": "./bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "web/dist",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "SUPPORT.md",
    ".env.example"
  ],
  "scripts": {
    "test": "jest",
    "coverage": "jest --coverage --runInBand",
    "lint": "eslint src/ bin/",
    "check": "npm test -- --runInBand && npm run build:web",
    "build:web": "cd web && npm run build",
    "dashboard": "node bin/cli.js dashboard",
    "dashboard:dev": "node bin/cli.js dashboard --dev",
    "api": "node -e \"const { startServer } = require('./src/web/server'); startServer(process.cwd(), 3456);\""
  },
  "keywords": [
    "cli",
    "ai",
    "context",
    "developer-tools",
    "prompt",
    "codebase",
    "claude",
    "chatgpt",
    "cursor"
  ],
  "author": "hzh1117",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/hzh1117/Code-ctx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzh1117/Code-ctx.git"
  },
  "bugs": {
    "url": "https://github.com/hzh1117/Code-ctx/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "chalk": "^4.1.0",
    "chardet": "^1.6.0",
    "clipboardy": "3.0.0",
    "commander": "^14.0.3",
    "concurrently": "^9.2.1",
    "express": "~5.2.1",
    "glob": "^10.5.0",
    "iconv-lite": "^0.7.2"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "jest": "^29.0.0"
  },
  "jest": {
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/web/dist/",
      "/tests/fixtures/",
      "/tests/helpers/"
    ]
  }
}
